generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  GERENTE
  CAJERO
  COCINA
  REPARTIDOR
}

model Branch {
  id            Int            @id @default(autoincrement())
  name          String
  address       String
  users         User[]
  orders        Order[]
  cashRegisters CashRegister[]
  createdAt     DateTime       @default(now())
}

model User {
  id            Int            @id @default(autoincrement())
  name          String
  email         String         @unique
  password      String
  role          Role           @default(CAJERO)
  active        Boolean        @default(true)
  branchId      Int?
  branch        Branch?        @relation(fields: [branchId], references: [id])
  orders        Order[]
  cashRegisters CashRegister[]
  createdAt     DateTime       @default(now())
}

model Product {
  id          Int         @id @default(autoincrement())
  name        String
  price       Decimal     @db.Decimal(10, 2)
  orderItems  OrderItem[]
  createdAt   DateTime    @default(now())
}

enum OrderStatus {
  PENDIENTE
  PREPARACION
  ENVIADO
  ENTREGADO
  CANCELADO
}

model Order {
  id              Int          @id @default(autoincrement())
  userId          Int
  user            User         @relation(fields: [userId], references: [id])
  branchId        Int
  branch          Branch       @relation(fields: [branchId], references: [id])
  cashRegisterId  Int?         @map("cash_register_id") // NUEVO: Relación con la caja
  cashRegister    CashRegister? @relation(fields: [cashRegisterId], references: [id]) // NUEVO
  total           Decimal      @db.Decimal(10, 2)
  status          OrderStatus  @default(PENDIENTE)
  items           OrderItem[]
  createdAt       DateTime     @default(now())
  
  @@map("orders")
}


model OrderItem {
  id        Int     @id @default(autoincrement())
  orderId   Int
  order     Order   @relation(fields: [orderId], references: [id])
  productId Int
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
}

enum CashRegisterStatus {
  OPEN
  CLOSED
}

model CashRegister {
  id              Int                @id @default(autoincrement())
  initialAmount   Decimal            @db.Decimal(10, 2)
  generatedAmount Decimal            @default(0.00) @db.Decimal(10, 2)
  totalAmount     Decimal            @default(0.00) @db.Decimal(10, 2)
  status          CashRegisterStatus @default(OPEN)
  openedAt        DateTime           @default(now())
  closedAt        DateTime?
  openedById      Int
  openedBy        User               @relation(fields: [openedById], references: [id])
  branchId        Int
  branch          Branch             @relation(fields: [branchId], references: [id])
  orders          Order[]            // NUEVO: Relación con órdenes
  
  @@map("cash_registers")
}